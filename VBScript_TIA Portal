Sub Excel_Report()

Option Explicit

Dim objExcelApp, objWorkbook, filePath, timestamp, savePath

' 1. Define Paths & Create Timestamp
filePath = "C:\Batch_Report\Batch_Report.xls" ' Path to your Excel Template
timestamp = Year(Now) & "-" & Right("0" & Month(Now), 2) & "-" & Right("0" & Day(Now), 2) & "_" & _
            Right("0" & Hour(Now), 2) & "-" & Right("0" & Minute(Now), 2)

savePath = "C:\Batch_Report\Batch_Report_" & timestamp & ".xls"

' 2. Instantiate Excel Application
On Error Resume Next
Set objExcelApp = CreateObject("Excel.Application")

If Err.Number <> 0 Then
    ShowSystemAlarm "Excel could not be started. Check if Excel is installed."
    Exit Sub
End If
On Error GoTo 0

objExcelApp.Visible = False
objExcelApp.DisplayAlerts = False

' 3. Open Template
Set objWorkbook = objExcelApp.Workbooks.Open(filePath)

' 4. Map HMI Recipe Tags to specific Excel Cells
' (Update Row & Column indices and HMI Tag names to match your project)
objWorkbook.Sheets(1).Cells(2, 1).Value = SmartTags("Customer_name").Read
objWorkbook.Sheets(1).Cells(2, 2).Value = SmartTags("Site_Name").Read
objWorkbook.Sheets(1).Cells(2, 3).Value = SmartTags("Address").Read
objWorkbook.Sheets(1).Cells(2, 4).Value = timestamp
objWorkbook.Sheets(1).Cells(2, 5).Value = SmartTags("Grade").Read
objWorkbook.Sheets(1).Cells(2, 6).Value = SmartTags("Cement").Read
objWorkbook.Sheets(1).Cells(4, 7).Value = SmartTags("Water").Read
objWorkbook.Sheets(1).Cells(5, 8).Value = SmartTags("Aggrigate1").Read
objWorkbook.Sheets(1).Cells(5, 9).Value = SmartTags("Aggrigate2").Read
objWorkbook.Sheets(1).Cells(5, 10).Value = SmartTags("Aggrigate3").Read
objWorkbook.Sheets(1).Cells(5, 11).Value = SmartTags("Aggrigate4").Read
objWorkbook.Sheets(1).Cells(5, 12).Value = SmartTags("Admixer").Read
objWorkbook.Sheets(1).Cells(5, 13).Value = SmartTags("Operator_name").Read

' 5. Save the Excel File and Clean Up
objWorkbook.SaveAs savePath
objWorkbook.Close False
objExcelApp.Quit

Set objWorkbook = Nothing
Set objExcelApp = Nothing

ShowSystemAlarm "Recipe successfully exported to Excel!"

End Sub





