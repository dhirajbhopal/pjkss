Sub Report_Script()

    Dim objExcel
    Dim objWorkbook
    Dim objSheet
    Dim filePath
    Dim nextRow
    Dim mydate
    Dim mytime

    On Error Resume Next

    filePath = "C:\Batch_Report\Batch_Report.xlsx"
    mydate = Right("0" & Month(Now), 2) & "-" & Right("0" & Day(Now), 2) & "-" & Year(Now)
    mytime = Right("0" & Hour(Now), 2) & ":" & Right("0" & Minute(Now), 2)

    Set objExcel = CreateObject("Excel.Application")
    objExcel.Visible = False
    objExcel.DisplayAlerts = False

    Set objWorkbook = objExcel.Workbooks.Open(filePath)
    Set objSheet = objWorkbook.Sheets(1)

    'Find next empty row
    nextRow = 2

    Do While objSheet.Cells(nextRow,1).Value <> ""
        nextRow = nextRow + 1
    Loop

    objSheet.Cells(nextRow,1).Value = mydate
    objSheet.Cells(nextRow,2).Value = mytime
    objSheet.Cells(nextRow,3).Value = SmartTags("Customer_name")
    objSheet.Cells(nextRow,4).Value = SmartTags("Site_Name")
    objSheet.Cells(nextRow,5).Value = SmartTags("Address")
    objSheet.Cells(nextRow,6).Value = SmartTags("Grade")
    objSheet.Cells(nextRow,7).Value = SmartTags("Cement_Target")
    objSheet.Cells(nextRow,8).Value = SmartTags("Water_Target")
    objSheet.Cells(nextRow,9).Value = SmartTags("Aggrigate1_Target")
    objSheet.Cells(nextRow,10).Value = SmartTags("Aggrigate2_Target")
    objSheet.Cells(nextRow,11).Value = SmartTags("Aggrigate3_Target")
    objSheet.Cells(nextRow,12).Value = SmartTags("Aggrigate4_Target")
    objSheet.Cells(nextRow,13).Value = SmartTags("Admixer_Target")
    objSheet.Cells(nextRow,14).Value = SmartTags("Operator_name")

    objWorkbook.Save

    objWorkbook.Close
    objExcel.Quit

    Set objSheet = Nothing
    Set objWorkbook = Nothing
    Set objExcel = Nothing

    If Err.Number <> 0 Then
        ShowSystemAlarm Err.Description
        Err.Clear
    Else
        ShowSystemAlarm "Report Saved Successfully"
    End If

End Sub