Sub Report_Script()
    ' Declare internal variables
    Dim objExcel, objWorkbook, objSheet
    Dim filePath, fileName, fullPath
    Dim timeStamp, folderPath
    
    On Error Resume Next
    
    ' 1. Define paths and file details
    folderPath = "C:\Batch_Report\"
    timeStamp = Year(Now) & Right("0" & Month(Now), 2) & Right("0" & Day(Now), 2) & "_" & Right("0" & Hour(Now), 2) & Right("0" & Minute(Now), 2)
    fileName = "Production_Report_" & timeStamp & ".xlsx"
    fullPath = folderPath & fileName

    ' 2. Create the target directory if it does not exist
    Dim fso
    Set fso = CreateObject("Scripting.FileSystemObject")
    If Not fso.FolderExists(folderPath) Then
        fso.CreateFolder(folderPath)
    End If
    Set fso = Nothing

    ' 3. Initialize Excel Application Instance
    Set objExcel = CreateObject("Excel.Application")
    objExcel.Visible = False ' Keep Excel invisible during processing
    objExcel.DisplayAlerts = False ' Suppress overwrite alerts

    ' 4. Create a new workbook and select active sheet
    Set objWorkbook = objExcel.Workbooks.Add
    Set objSheet = objWorkbook.Sheets(1)
    objSheet.Name = "Report Data"

    ' 5. Create Report Headers
    objSheet.Cells(1, 1).Value = "Production Report"
    objSheet.Cells(3, 1).Value = "Timestamp:"
    objSheet.Cells(3, 2).Value = Now
    
    objSheet.Cells(5, 1).Value = "Parameter Name"
    objSheet.Cells(5, 2).Value = "Value"

    ' 6. Map TIA Portal HMI SmartTags to Excel Cells
    ' Format: objSheet.Cells(Row, Column).Value = SmartTags("Your_HMI_Tag")
    objSheet.Cells(6, 1).Value = "Customer_name"
    objSheet.Cells(6, 2).Value = SmartTags("Customer_name")
    
    objSheet.Cells(7, 1).Value = "Site_Name"
    objSheet.Cells(7, 2).Value = SmartTags("Site_Name")
    
    objSheet.Cells(8, 1).Value = "Address"
    objSheet.Cells(8, 2).Value = SmartTags("Address")

    ' 7. Save and Close the Excel file cleanly
    objWorkbook.SaveAs fullPath
    objWorkbook.Close True
    objExcel.Quit

    ' 8. Free up system memory resources
    Set objSheet = Nothing
    Set objWorkbook = Nothing
    Set objExcel = Nothing
    
    ' Error check notification
    If Err.Number <> 0 Then
        ShowSystemAlarm "Report Error: " & Err.Description
        Err.Clear
    Else
        ShowSystemAlarm "Excel Report saved successfully to " & fullPath
    End If
End Sub




